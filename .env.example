# RAG Knowledge — 環境依存設定（git 管理外）
# 共通設定は config.toml を参照
# 設定管理仕様: docs/specs/rag-knowledge.md#設定管理

# Embedding 接続
# local or online
EMBEDDING_PROVIDER=local
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ストレージ
CHROMADB_PERSIST_DIR=./chroma_db
BM25_PERSIST_DIR=./bm25_index
SOURCE_STORE_DIR=./source_store
CONVERTED_STORE_DIR=./converted_store

# ChromaDB サーバー接続
CHROMADB_SERVER_HOST=localhost
CHROMADB_SERVER_PORT=8000
# MCP サーバー起動時に ChromaDB サーバーを自動起動 (true/false)
CHROMADB_AUTO_START=true

# トランスポート (stdio or http)
RAG_TRANSPORT=stdio
RAG_HTTP_HOST=127.0.0.1
RAG_HTTP_PORT=8081
RAG_DNS_REBINDING_PROTECTION=true

# Embedding 並列数（rebuild 時のソース並列処理）
RAG_EMBEDDING_CONCURRENCY=32

# デバッグ
RAG_DEBUG_LOG_ENABLED=false

# ログファイル出力ディレクトリ（未設定時は stderr のみ）
# RAG_LOG_DIR=./logs

# YouTube インジェスター（Whisper）
RAG_YOUTUBE_WHISPER_MODEL=base
RAG_YOUTUBE_WHISPER_DEVICE=cuda

# YouTube Fake モード（テスト・QA で実 YouTube アクセスを排除する）
# デフォルトは安全側（true = fake 有効）。本番運用時のみコメントを外して false を明示する
# 仕様: docs/specs/infrastructure/fake-mode.md
# RAG_YOUTUBE_FAKE_MODE=false
# Fake Fetcher が読み込む fixture ディレクトリ（プロジェクトルートからの相対パス）
# RAG_YOUTUBE_FAKE_FIXTURE_DIR=src/rag/pipeline/ingesters/_fake/youtube/data

# BlueSky Fake モード（テスト・QA で実 BlueSky AT Protocol アクセスを排除する）
# デフォルトは安全側（true = fake 有効）。本番運用時のみコメントを外して false を明示する
# 仕様: docs/specs/infrastructure/fake-mode.md
# RAG_BLUESKY_FAKE_MODE=false
# Fake Fetcher が読み込む fixture ディレクトリ（プロジェクトルートからの相対パス）
# RAG_BLUESKY_FAKE_FIXTURE_DIR=src/rag/pipeline/ingesters/_fake/bluesky/data

# Zenn Fake モード（テスト・QA で実 Zenn API アクセスを排除する）
# デフォルトは安全側（true = fake 有効）。本番運用時のみコメントを外して false を明示する
# 仕様: docs/specs/infrastructure/fake-mode.md
# RAG_ZENN_FAKE_MODE=false
# Fake Fetcher が読み込む fixture ディレクトリ（プロジェクトルートからの相対パス）
# RAG_ZENN_FAKE_FIXTURE_DIR=src/rag/pipeline/ingesters/_fake/zenn/data

# Aozora Fake モード（テスト・QA で実 青空文庫 / GitHub Raw アクセスを排除する）
# デフォルトは安全側（true = fake 有効）。本番運用時のみコメントを外して false を明示する
# 仕様: docs/specs/infrastructure/fake-mode.md
# RAG_AOZORA_FAKE_MODE=false
# Fake Fetcher が読み込む fixture ディレクトリ（プロジェクトルートからの相対パス）
# RAG_AOZORA_FAKE_FIXTURE_DIR=src/rag/pipeline/ingesters/_fake/aozora/data

# Embedding Fake モード（テスト・CI で実 LM Studio / OpenAI Embedding API アクセスを排除する）
# デフォルトは安全側（true = fake 有効）。本番運用時のみコメントを外して false を明示する
# 仕様: docs/specs/infrastructure/fake-mode.md
# RAG_EMBEDDING_FAKE_MODE=false
# Fake Embedding が生成するベクトルの次元数（Real モデルの次元に合わせる）
# RAG_EMBEDDING_FAKE_DIMENSIONS=768

# Web (scrapy) Fake モード（site-ingest で実 Web アクセスを排除する上位スイッチ）
# デフォルトは安全側（true = fake 有効）。本番運用時のみコメントを外して false を明示する
# 仕様: docs/specs/infrastructure/fake-mode.md
# RAG_WEB_FAKE_MODE=false
# Fake ScrapyRunner が読み込む fixture ディレクトリ（プロジェクトルートからの相対パス）
# RAG_SCRAPY_FAKE_FIXTURE_DIR=src/rag/scrapy/_fake/data

# サイト一括取り込み
SITE_INGEST_TEMP_DIR=.tmp/site_ingest
